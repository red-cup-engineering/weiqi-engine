{
  "name": "@red-cup-engineering/weiqi-engine",
  "version": "0.3.7-dev.0",
  "type": "module",
  "description": "Weiqi's deterministic game engine: rules, scoring, SGF, semantic move events, and a Cartridge replay adapter. It specializes the shared game-engine contract without duplicating its log or hash protocol.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/weiqi-engine.git"
  },
  "license": "MIT",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./build-browser": "./scripts/build-browser-kernel.mjs",
    "./match": "./src/match.mjs",
    "./replay": "./src/replay.mjs",
    "./testing": "./test/helpers/session-fixtures.mjs"
  },
  "deliberateEntries": [
    {
      "path": "src/index.mjs",
      "reason": "The kernel chokepoint that weiqi-content-checker's DEFAULT_KERNEL_PATH resolves through via import.meta.resolve, not a re-export convenience."
    }
  ],
  "files": [
    "src",
    "scripts/build-browser-kernel.mjs",
    "README.md"
  ],
  "dependencies": {
    "@red-cup-engineering/json-engine": "^0.5.0",
    "@red-cup-engineering/typed-content": "^0.1.0",
    "@red-cup-engineering/project-browser-asset-tree-computer-systems-publishing-engineering-services-section": "0.4.7-dev.0",
    "@red-cup-engineering/game-engine": "0.1.0-dev.0",
    "@red-cup-engineering/signcell": "^0.18.0 || 0.18.1-dev.0"
  },
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "devDependencies": {
    "@red-cup-engineering/json-engine": "^0.5.0",
    "@red-cup-engineering/signcell": "^0.17.5"
  }
}
